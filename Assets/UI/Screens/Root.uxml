<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" editor-extension-mode="False">
    <Style src="/Assets/UI/Styles/main.uss" />
    <ui:VisualElement name="app-root" class="app-root">

        <ui:VisualElement name="screen-store" class="screen screen-store" style="display: none;">
            <ui:VisualElement class="screen-header">
                <ui:Button name="store-back-button" class="icon-button back-button" />
                <ui:Label name="store-title-label" class="screen-header-title" />
                <ui:VisualElement class="coin-badge-group">
                    <ui:VisualElement class="coin-badge">
                        <ui:VisualElement class="coin-dot coin-dot--hard" />
                        <ui:Label name="store-hard-currency-label" class="coin-badge-value" />
                    </ui:VisualElement>
                    <ui:Button name="store-add-currency-button" class="icon-button coin-add-button" />
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:VisualElement name="store-tab-list" class="tab-row" />
            <ui:ScrollView mode="Vertical" class="store-content">
                <ui:VisualElement name="store-item-grid" class="grid-2col" />
            </ui:ScrollView>
        </ui:VisualElement>

        <ui:VisualElement name="screen-settings" class="screen screen-settings" style="display: none;">
            <ui:VisualElement class="screen-header">
                <ui:Button name="settings-back-button" class="icon-button back-button" />
                <ui:Label name="settings-title-label" class="screen-header-title" />
            </ui:VisualElement>
            <ui:ScrollView mode="Vertical" class="settings-content">
                <ui:VisualElement class="card settings-card">
                    <ui:Label name="settings-language-label" class="section-label" />
                    <ui:DropdownField name="settings-language-dropdown" class="settings-dropdown" />
                    <ui:Label name="settings-language-note-label" class="settings-note" />
                </ui:VisualElement>
                <ui:VisualElement class="card settings-card">
                    <ui:Label name="settings-sound-label" class="section-label" />
                    <ui:Slider name="settings-sound-slider" low-value="0" high-value="1" class="settings-slider" />
                    <ui:Label name="settings-music-label" class="section-label" />
                    <ui:Slider name="settings-music-slider" low-value="0" high-value="1" class="settings-slider" />
                </ui:VisualElement>
                <ui:VisualElement class="card settings-card">
                    <ui:Label name="settings-duel-label" class="section-label" />
                    <ui:Toggle name="settings-duel-demo-toggle" class="settings-toggle" />
                </ui:VisualElement>
            </ui:ScrollView>
            <ui:Button name="settings-delete-account-button" class="danger-button" />
        </ui:VisualElement>

        <ui:VisualElement name="screen-rps-menu" class="screen screen-rps-menu" style="display: none;">
            <ui:VisualElement class="header-bar">
                <ui:Button name="rps-menu-back-button" class="icon-button back-button" />
                <ui:VisualElement class="coin-badge-group" style="display: none;" />
            </ui:VisualElement>
            <ui:VisualElement class="home-content">
                <ui:Label name="rps-menu-title-label" class="screen-title" />
                <ui:Label name="rps-menu-subtitle-label" class="rps-menu-subtitle" />
                <ui:Button name="rps-play-button" class="primary-button primary-button--large" />
            </ui:VisualElement>
            <ui:VisualElement class="home-secondary-row">
                <ui:VisualElement name="rps-menu-duels-button" class="secondary-nav-button">
                    <ui:Label name="rps-menu-duels-icon-label" class="secondary-nav-icon" />
                    <ui:Label name="rps-menu-duels-label" class="secondary-nav-label" />
                </ui:VisualElement>
                <ui:VisualElement name="rps-menu-store-button" class="secondary-nav-button">
                    <ui:Label name="rps-menu-store-icon-label" class="secondary-nav-icon" />
                    <ui:Label name="rps-menu-store-label" class="secondary-nav-label" />
                </ui:VisualElement>
                <ui:VisualElement name="rps-menu-settings-button" class="secondary-nav-button">
                    <ui:Label name="rps-menu-settings-icon-label" class="secondary-nav-icon" />
                    <ui:Label name="rps-menu-settings-label" class="secondary-nav-label" />
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>

        <ui:VisualElement name="screen-rps-mode-select" class="screen screen-rps-mode-select" style="display: none;">
            <ui:VisualElement class="screen-header">
                <ui:Button name="rps-mode-back-button" class="icon-button back-button" />
                <ui:Label name="rps-mode-title-label" class="screen-header-title" />
            </ui:VisualElement>
            <ui:VisualElement name="rps-mode-card-list" class="card-column">
                <ui:VisualElement name="rps-mode-single-card" class="mode-card">
                    <ui:VisualElement name="rps-mode-single-icon" class="card-icon card-icon--image card-icon--single-player" />
                    <ui:Label name="rps-mode-single-title-label" class="card-title" />
                    <ui:Label name="rps-mode-single-description-label" class="card-description" />
                </ui:VisualElement>
                <ui:VisualElement name="rps-mode-local-card" class="mode-card">
                    <ui:VisualElement name="rps-mode-local-icon" class="card-icon card-icon--image card-icon--local-2p" />
                    <ui:Label name="rps-mode-local-title-label" class="card-title" />
                    <ui:Label name="rps-mode-local-description-label" class="card-description" />
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>

        <ui:VisualElement name="screen-rps-character-select" class="screen screen-rps-character-select" style="display: none;">
            <ui:VisualElement class="screen-header">
                <ui:Button name="charselect-back-button" class="icon-button back-button" />
                <ui:Label name="charselect-title-label" class="screen-header-title" />
            </ui:VisualElement>
            <ui:Label name="charselect-subtitle-label" class="rps-menu-subtitle" />
            <ui:Label name="charselect-turn-label" class="charselect-turn" />
            <ui:Label name="charselect-score-label" class="charselect-score" />
            <ui:VisualElement name="charselect-character-list" class="charselect-character-row">
                <ui:VisualElement name="charselect-caballero" class="charselect-character-card">
                    <ui:VisualElement name="charselect-caballero-sprite" class="charselect-character-sprite" />
                    <ui:Label name="charselect-caballero-name" class="charselect-character-name" />
                </ui:VisualElement>
                <ui:VisualElement name="charselect-maga" class="charselect-character-card">
                    <ui:VisualElement name="charselect-maga-sprite" class="charselect-character-sprite" />
                    <ui:Label name="charselect-maga-name" class="charselect-character-name" />
                </ui:VisualElement>
                <ui:VisualElement name="charselect-asesino" class="charselect-character-card">
                    <ui:VisualElement name="charselect-asesino-sprite" class="charselect-character-sprite" />
                    <ui:Label name="charselect-asesino-name" class="charselect-character-name" />
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>

        <ui:VisualElement name="screen-rps-vs" class="screen screen-rps-vs" style="display: none;">
            <ui:Label name="vs-round-label" class="vs-round-label" />
            <ui:Label name="vs-score-label" class="vs-score-label" />
            <ui:VisualElement class="vs-stage">
                <ui:VisualElement name="vs-left" class="vs-side">
                    <ui:VisualElement name="vs-left-sprite" class="vs-sprite" />
                    <ui:Label name="vs-left-name" class="vs-name" />
                </ui:VisualElement>
                <ui:VisualElement name="vs-right" class="vs-side">
                    <ui:VisualElement name="vs-right-sprite" class="vs-sprite" />
                    <ui:Label name="vs-right-name" class="vs-name" />
                </ui:VisualElement>
                <ui:Label name="vs-draw-label" class="vs-draw-label" text="EMPATE" style="display: none;" />
            </ui:VisualElement>
            <ui:Label name="vs-series-label" class="vs-series-label" style="display: none;" />
            <ui:VisualElement class="button-row vs-button-row">
                <ui:Button name="vs-rematch-button" class="primary-button" style="display: none;" />
                <ui:Button name="vs-menu-button" class="secondary-button" style="display: none;" />
            </ui:VisualElement>
        </ui:VisualElement>

        <ui:VisualElement name="screen-duel-hub" class="screen screen-duel-hub" style="display: none;">
            <ui:VisualElement class="screen-header">
                <ui:Button name="duel-hub-back-button" class="icon-button back-button" />
                <ui:Label name="duel-hub-title-label" class="screen-header-title" />
            </ui:VisualElement>
            <ui:Label name="duel-hub-empty-label" class="duel-empty-label" />
            <ui:ScrollView name="duel-hub-list" mode="Vertical" class="duel-hub-list" />
            <ui:Button name="duel-hub-new-button" class="primary-button" />
            <ui:Button name="duel-hub-idle-button" class="secondary-button" style="display: none;" />
        </ui:VisualElement>

        <ui:VisualElement name="screen-duel" class="screen screen-duel" style="display: none;">
            <ui:VisualElement class="screen-header">
                <ui:Button name="duel-back-button" class="icon-button back-button" />
                <ui:Label name="duel-round-label" class="screen-header-title" />
            </ui:VisualElement>

            <ui:VisualElement class="duel-stage">
                <ui:VisualElement class="duel-side">
                    <ui:VisualElement name="duel-left-sprite" class="duel-sprite" />
                    <ui:Label name="duel-left-name" class="duel-name" />
                    <ui:VisualElement class="duel-hp-track">
                        <ui:VisualElement name="duel-left-hp-fill" class="duel-hp-fill" />
                    </ui:VisualElement>
                    <ui:Label name="duel-left-hp-label" class="duel-hp-label" />
                </ui:VisualElement>
                <ui:Label name="duel-vs-label" class="duel-vs-label" text="VS" />
                <ui:VisualElement class="duel-side">
                    <ui:VisualElement name="duel-right-sprite" class="duel-sprite" />
                    <ui:Label name="duel-right-name" class="duel-name" />
                    <ui:VisualElement class="duel-hp-track">
                        <ui:VisualElement name="duel-right-hp-fill" class="duel-hp-fill duel-hp-fill--rival" />
                    </ui:VisualElement>
                    <ui:Label name="duel-right-hp-label" class="duel-hp-label" />
                    <ui:VisualElement class="duel-slot-row duel-slot-row--rival">
                        <ui:Label name="duel-rival-slot-0" class="duel-slot duel-slot--rival" />
                        <ui:Label name="duel-rival-slot-1" class="duel-slot duel-slot--rival" />
                        <ui:Label name="duel-rival-slot-2" class="duel-slot duel-slot--rival" />
                    </ui:VisualElement>
                </ui:VisualElement>
            </ui:VisualElement>

            <ui:Label name="duel-status-label" class="duel-status" />
            <ui:Label name="duel-countdown-label" class="duel-countdown" />

            <ui:VisualElement name="duel-slot-row" class="duel-slot-row">
                <ui:Button name="duel-slot-0" class="duel-slot" />
                <ui:Button name="duel-slot-1" class="duel-slot" />
                <ui:Button name="duel-slot-2" class="duel-slot" />
            </ui:VisualElement>

            <ui:VisualElement name="duel-picker-row" class="duel-picker-row">
                <ui:VisualElement name="duel-pick-guerrero" class="duel-pick">
                    <ui:Label name="duel-pick-guerrero-icon" class="duel-pick-icon" />
                    <ui:Label name="duel-pick-guerrero-label" class="duel-pick-label" />
                </ui:VisualElement>
                <ui:VisualElement name="duel-pick-maga" class="duel-pick">
                    <ui:Label name="duel-pick-maga-icon" class="duel-pick-icon" />
                    <ui:Label name="duel-pick-maga-label" class="duel-pick-label" />
                </ui:VisualElement>
                <ui:VisualElement name="duel-pick-asesino" class="duel-pick">
                    <ui:Label name="duel-pick-asesino-icon" class="duel-pick-icon" />
                    <ui:Label name="duel-pick-asesino-label" class="duel-pick-label" />
                </ui:VisualElement>
            </ui:VisualElement>

            <ui:Button name="duel-confirm-button" class="primary-button" />
            <ui:Button name="duel-claim-button" class="danger-button" style="display: none;" />

            <ui:VisualElement name="duel-result-overlay" class="overlay" style="display: none;">
                <ui:VisualElement class="duel-result-panel">
                    <ui:Label name="duel-result-title-label" class="screen-title" />
                    <ui:Label name="duel-result-detail-label" class="duel-result-detail" />
                    <ui:VisualElement name="duel-result-rows" class="duel-result-rows" />
                    <ui:Button name="duel-result-continue-button" class="primary-button" />
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>

        <ui:VisualElement name="confirm-dialog-overlay" class="overlay" style="display: none;">
            <ui:VisualElement class="confirm-dialog-panel">
                <ui:Label name="confirm-dialog-title-label" class="screen-title" />
                <ui:Label name="confirm-dialog-message-label" class="confirm-dialog-message" />
                <ui:VisualElement class="button-row">
                    <ui:Button name="confirm-dialog-cancel-button" class="secondary-button" />
                    <ui:Button name="confirm-dialog-confirm-button" class="danger-button" />
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>

        <ui:VisualElement name="toast" class="toast" style="display: none;">
            <ui:Label name="toast-label" class="toast-label" />
        </ui:VisualElement>

    </ui:VisualElement>
</ui:UXML>
